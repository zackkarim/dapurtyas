# ==============================================================================
# DAPUR TYAS by TECNO GARAGE - Apache & Web Hosting Configuration
# ==============================================================================

# 1. Nonaktifkan penjelajahan direktori (Directory Browsing)
Options -Indexes

# 2. Lindungi file sensitif agar tidak bisa diunduh langsung dari browser
<FilesMatch "^(\.env|\.env\.example|\.git.*|.*\.sql|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Default Charset
AddDefaultCharset UTF-8

# 4. Keamanan Header HTTP Dasar
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
