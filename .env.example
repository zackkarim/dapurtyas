# ==============================================================================
# DAPUR TYAS by TECNO GARAGE - Environment Configuration File
# ==============================================================================
# Salin file ini menjadi ".env" di server hosting Anda:
#   cp .env.example .env
#
# Lalu sesuaikan konfigurasi database sesuai akun MySQL cPanel/Hosting Anda.
# ==============================================================================

# Mode Aplikasi: 'production' saat di-hosting live, 'development' saat di komputer lokal
APP_ENV=production

# Konfigurasi Database Hosting
# Pada cPanel/Shared Hosting, nama DB dan User biasanya memiliki prefix akun cPanel (cth: u123456_dapurtyas)
DB_HOST=localhost
DB_NAME=dapur_tyas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
